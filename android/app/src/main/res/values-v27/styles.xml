<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+: gezinme çubuğu simgeleri de açık zeminde koyu -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#ecebf5</item>
        <item name="android:navigationBarColor">#ecebf5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
